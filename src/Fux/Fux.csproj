<Project Sdk="Microsoft.NET.Sdk">

  <!--
    fux: the cross-platform terminal XML editor. A Terminal.Gui front end over the reused
    XmlNotepad `Model` engine (XmlCache/DomLoader/Checker/SchemaCache/...).
    Terminal.Gui v2: TrueColor (pin real RGB, chrome no longer shifts with the terminal
    palette) + real Border/Adornment model for the bordered panes. Pinned to the stable
    2.4.x tags, not -develop.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>fux</AssemblyName>
    <RootNamespace>Fux</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    fux's own assembly metadata. Deliberately NOT ../Version/Version.props: that file is
    upstream's and stamps Company/Product/Copyright as Microsoft Corporation / XmlNotepad,
    which is correct for the assemblies that import it (Model, XmlNotepad, Application) and
    wrong for this one. Without these properties the SDK defaults Company and Product to the
    assembly name and emits no copyright at all, so a shipped `fux` carried no attribution.
    Both holders are named here because the binary bundles Microsoft's engine: see LICENSE
    and THIRD-PARTY-NOTICES.md.
  -->
  <PropertyGroup>
    <Product>fux</Product>
    <Authors>Marcel Samek</Authors>
    <Company>Marcel Samek</Company>
    <Copyright>Copyright © 2026 Marcel Samek. Portions Copyright © Microsoft Corporation.</Copyright>
    <Description>A cross-platform terminal XML editor, derived from Microsoft XML Notepad.</Description>
    <RepositoryUrl>https://github.com/MarcelInTO/fux</RepositoryUrl>
    <!--
      Placeholder, not a release number. release.yml overrides it with -p:Version from the
      git tag, so this value only ever reaches a build from source. Naming that build 0.0.0
      keeps it from impersonating a release: it used to say 0.1.0, which stayed frozen while
      real releases moved on, so `make` produced a binary reporting a version that had long
      since shipped and meant something else.
    -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xml.SgmlReader" Version="1.8.30" />
    <!--
      JSON import, matching XmlNotepad's FormMain.ImportJson. Newtonsoft rather than
      System.Text.Json because only it has DeserializeXmlNode: the JSON-to-XML mapping
      (arrays to repeated elements, "@name" to attributes, "#text", name sanitizing) is a
      set of conventions, and hand-rolling them would invent a different dialect from the
      one XmlNotepad users already have. Upstream pins 13.0.x too.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
    <PackageReference Include="Terminal.Gui" Version="2.4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Model/Model.csproj" />
  </ItemGroup>

</Project>
