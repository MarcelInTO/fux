<Project Sdk="Microsoft.NET.Sdk">

  <!--
    fux: the cross-platform terminal XML editor. A Terminal.Gui front end over the reused
    XmlNotepad `Model` engine (XmlCache/DomLoader/Checker/SchemaCache/...).
    Terminal.Gui v2: TrueColor (pin real RGB, chrome no longer shifts with the terminal
    palette) + real Border/Adornment model for the bordered panes. Pinned to the stable
    2.4.x tags, not -develop.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>fux</AssemblyName>
    <RootNamespace>Fux</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Xml.SgmlReader" Version="1.8.30" />
    <!--
      JSON import, matching XmlNotepad's FormMain.ImportJson. Newtonsoft rather than
      System.Text.Json because only it has DeserializeXmlNode: the JSON-to-XML mapping
      (arrays to repeated elements, "@name" to attributes, "#text", name sanitizing) is a
      set of conventions, and hand-rolling them would invent a different dialect from the
      one XmlNotepad users already have. Upstream pins 13.0.x too.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
    <PackageReference Include="Terminal.Gui" Version="2.4.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Model/Model.csproj" />
  </ItemGroup>

</Project>
